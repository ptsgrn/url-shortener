{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./db": "./src/db/index.ts",
    "./auth": "./src/modules/auth/service.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "dev:standalone": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "prettier --check . && eslint --max-warnings 0 .",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.17",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "jose": "^6.2.17",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.9.1",
    "eslint-plugin-neverthrow": "^1.1.4",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "wrangler": "4.162.0"
  }
}
